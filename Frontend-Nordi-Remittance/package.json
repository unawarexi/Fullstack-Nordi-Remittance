{
  "name": "remitwave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "docker:build": "docker build -t nordi-frontend .",
    "docker:run": "docker run -p 3001:80 nordi-frontend",
    "clean": "rm -rf dist coverage node_modules/.cache"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.4",
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.1.3",
    "@hookform/resolvers": "^5.2.2",
    "@material-tailwind/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.90.20",
    "@types/axios": "^0.14.0",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "formik": "^2.4.6",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.501.0",
    "react": "^18.2.0",
    "react-datepicker": "^6.9.0",
    "react-day-picker": "^9.3.2",
    "react-dom": "^18.2.0",
    "react-icons": "^5.3.0",
    "react-loader-spinner": "^6.1.6",
    "react-router": "^6.23.1",
    "react-router-dom": "^6.23.1",
    "react-select": "^5.8.0",
    "recharts": "^2.15.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.3",
    "swiper": "^11.1.15",
    "tailwind-merge": "^2.5.5",
    "yup": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^18.2.66",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.5.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.17",
    "ts-morph": "^27.0.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
