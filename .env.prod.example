# ============================================================================
# NORDI REMITTANCE — PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env.prod and fill in real values
# NEVER commit .env.prod to git
# ============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://nordi-remittance.com
VITE_API_URL=https://api.nordi-remittance.com
VITE_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# ── Database (MongoDB) ────────────────────────────────────────────────────────
# Option A: MongoDB Atlas (recommended for production)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/remit?retryWrites=true&w=majority
# Option B: Self-hosted MongoDB in Docker
# MONGODB_URI=mongodb://admin:CHANGE_ME@mongo:27017/remit?authSource=admin
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
# Option A: Redis Cloud (matches existing .env settings)
REDIS_URL=redis://:CHANGE_ME@redis:6379
BULLMQ_REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Docker internal: kafka:9092 | AWS MSK: broker1:9092,broker2:9092
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=nordi-remit-api
KAFKA_GROUP_ID=nordi-remit-group
KAFKA_SSL=false
# For AWS MSK with SASL:
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=CHANGE_ME
# KAFKA_SASL_PASSWORD=CHANGE_ME

# ── Kafka UI Auth (Production) ────────────────────────────────────────────────
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT & Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_64_chars_random_string_for_production_use
JWT_REFRESH_SECRET=CHANGE_ME_another_64_chars_random_string_different_from_above
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=nordi-remittance

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_exactly_32_characters!!

# ── Clerk Authentication ──────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Cloudinary (Image Uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASS=CHANGE_ME_app_password
SMTP_FROM=noreply@nordi-remittance.com
SMTP_FROM_NAME=Nordi Remittance
SUPPORT_EMAIL=support@nordi-remittance.com

# ── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml:8000
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# ── LLM API Keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
GOOGLE_AI_KEY=CHANGE_ME
HUGGINGFACE_API_KEY=hf_CHANGE_ME

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_2FA=true
ENABLE_KYC_VERIFICATION=true
ENABLE_FRAUD_DETECTION=true
ENABLE_AI_AGENT=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=https://nordi-remittance.com,https://api.nordi-remittance.com

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=CHANGE_ME@nordi-remittance.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
