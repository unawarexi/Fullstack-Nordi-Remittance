# ============================================================================
# NORDI REMITTANCE — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all required values.
# Lines without a default are REQUIRED and the app will throw at startup.
# ============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | production | test
PORT=3000
HOST=0.0.0.0
API_VERSION=v1
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173      # Used in email links and CORS

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nordi_remittance
# MONGOOSE_DEBUG=false                  # Set true to print all Mongoose queries

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-min-64-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=nordi-remittance

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Full URL used by BullMQ workers (takes precedence over host/port if set)
BULLMQ_REDIS_URL=redis://localhost:6379/1

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000             # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Admin Seed ────────────────────────────────────────────────────────────────
# Seeded on first startup via scripts/seedAdmin.ts
ADMIN_EMAIL=admin@nordi-remittance.com
ADMIN_PASSWORD=Change-Me-In-Production-1!

# ── SMTP / Mailer ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                       # true for port 465 (SSL), false for STARTTLS
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password             # Gmail: use an App Password, not your account password
SMTP_FROM_NAME=Nordi Remittance
SMTP_FROM_EMAIL=noreply@nordi-remittance.com
SUPPORT_EMAIL=support@nordi-remittance.com

# ── Cloudinary (file/KYC document uploads) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Clerk Authentication ──────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092            # Comma-separated: broker1:9092,broker2:9092
KAFKA_CLIENT_ID=nordi-remit-api
KAFKA_GROUP_ID=nordi-remit-group
KAFKA_SSL=false
# Required only when KAFKA_SSL=true and your broker needs SASL auth
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_2FA=true
ENABLE_KYC_VERIFICATION=true
ENABLE_FRAUD_DETECTION=true
ENABLE_AI_AGENT=true

# ── AI / LLM Providers ───────────────────────────────────────────────────────
# At least one is needed when ENABLE_AI_AGENT=true
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_KEY=AIza...
# HUGGINGFACE_API_KEY=hf_...
ML_SERVICE_URL=http://localhost:8000    # Nordi ML microservice (Nordi-Machine-Learning/)

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# SENTRY_DSN=https://your-key@sentry.io/project-id

# ── Elasticsearch / ELK Stack (structured logging) ───────────────────────────
# Leave unset to disable ELK transport (logs still written to logs/*.log for Filebeat)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme
# ELASTICSEARCH_INDEX=nordi-logs          # Default: nordi-logs (daily: nordi-logs-YYYY.MM.DD)
# LOGSTASH_HOST=localhost
# LOGSTASH_PORT=5044
