{
  "name": "nordi-remittance-backend",
  "version": "1.0.0",
  "description": "Remit - Online Banking and Remittance Platform Backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "clean-install": "rm -rf ./node_modules && rm -r package-lock.json && npm i",
    "start": "node dist/index.js",
    "start:dev": "tsx index.ts",
    "dev": "nodemon --watch . --ext ts --exec tsx index.ts",
    "dev:hot": "nodemon --exec \"npm run dev\" --watch --ext .ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:ui": "NODE_ENV=test vitest --ui",
    "typecheck": "tsc -b --noEmit",
    "type-check": "tsc -b --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky",
    "docker:build": "docker build -t remit-api .",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:seed": "tsx ./scripts/seed.ts",
    "db:migrate": "tsx ./scripts/migrate.ts",
    "db:create-indexes": "tsx ./scripts/create-indexes.ts",
    "db:verify-performance": "tsx ./scripts/verify-query-performance.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@clerk/express": "^2.1.23",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.18",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@sentry/node": "^10.56.0",
    "@sentry/profiling-node": "^10.56.0",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.78.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jet-validators": "^2.3.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "openai": "^6.42.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "svix": "^1.95.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.40",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-plugin-n": "^17.23.2",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "jet-logger": "^2.2.3",
    "lint-staged": "^17.0.7",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.0.17"
  }
}
