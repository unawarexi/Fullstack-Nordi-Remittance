#!/bin/sh
# Pre-push hook - Run tests before pushing to remote

echo "🧪 Running tests before push..."

# Run type checking
echo "📝 Type checking..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Push aborted."
  exit 1
fi

# Run linter
echo "🔍 Linting..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint check failed. Push aborted."
  exit 1
fi

# Run tests
echo "🧪 Running tests..."
npm run test
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All checks passed! Pushing to remote..."
