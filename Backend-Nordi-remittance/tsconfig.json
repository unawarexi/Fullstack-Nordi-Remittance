{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "baseUrl": "./",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@controllers/*": ["controllers/*"],
      "@models/*": ["models/*"],
      "@services/*": ["services/*"],
      "@mail/*": ["core/mail/*"],
      "@routes/*": ["routes/*"],
      "@core/*": ["core/*"],
      "@helpers/*": ["core/helpers/*"],
      "@config/*": ["config/*"],
      "@types/*": ["types/*"],
      "@ml/*": ["Nordi-Machine-Learning/app/*"]
    },
    "types": ["vitest/globals"]
  },

  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "require": ["tsconfig-paths/register"]
  },
  "include": ["**/*.ts", "index.ts"],
  "exclude": ["node_modules", "dist", "temp", "build", "src/public/*"]
}
