{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "baseUrl": "./",
    "outDir": "temp",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "@controllers/*": ["controllers/*"],
      "@models/*": ["models/*"],
      "@services/*": ["services/*"],
      "@mail/*": ["core/mail/*"],
      "@routes/*": ["routes/*"],
      "@helpers/*": ["core/helpers/*"],
      "@config/*": ["config/*"],
      "@types/*": ["types/*"],
      "@core/*": ["core/*"],
    },
    "sourceMap": false,
    "removeComments": true
  },
  "include": [
    "**/*.ts",
    "config.ts",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "temp",
    "build",
    "tests",
    "src/public/",
    "scripts",
    "eslint.config.ts",
    "vitest.config.js",
    "vitest.config.mts"
  ]
}
